# ---- secrets: NEVER commit ----
.env
*.key
*.pem

# ---- data: large and regenerable ----
# data/ reaches several GB. Regenerate locally with the builders.
# NOTE THE LEADING SLASH. Without it, "data/" matches a directory named
# data at ANY depth — including dashboard/data/ — which silently hides
# the exported JSON the site needs. Anchor it to the repo root.
/data/
/scratch/

# Generated dashboard JSON. None of it is tracked: the site reads
# cumulative.json, live.json and live_history.json from R2, where
# refresh.py and the poller publish them. Code goes through git; data
# does not. Served locally, the page reads the files the export and the
# poller just wrote here.
dashboard/data/*

# ---- python ----
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# ---- os / editor ----
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# ---- notes ----
*.docx
~$*

# ---- local notes and .env backups (nano's .env.save etc) ----
Help/
.env.*
!.env.example
