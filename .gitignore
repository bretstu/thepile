# ---- secrets: NEVER commit ----
.env
*.key
*.pem

# ---- data: large and regenerable ----
# data/ reaches several GB. Regenerate locally with the builders.
# NOTE THE LEADING SLASH. Without it, "data/" matches a directory named
# data at ANY depth — including dashboard/data/ — which silently hides
# the exported JSON the site needs. Anchor it to the repo root.
/data/
/scratch/

# Generated dashboard JSON. Ignore everything, then un-ignore the one
# file the site actually reads. The others (meta, blocktape, monthlies,
# families) fed the scrapped index.html; blocktape alone is one row per
# block and would add megabytes of new blob to git on every re-export.
# They regenerate in seconds from export.py, so re-add one the day a
# page reads it.
#
# The pattern must be "dashboard/data/*" and not "dashboard/data/":
# git cannot un-ignore a file inside an excluded DIRECTORY, only inside
# excluded CONTENTS.
dashboard/data/*
!dashboard/data/cumulative.json

# ---- python ----
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# ---- os / editor ----
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# ---- notes ----
*.docx
~$*

# ---- local notes and .env backups (nano's .env.save etc) ----
Help/
.env.*
!.env.example
