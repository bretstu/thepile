# Copy this file to .env and fill in your node's details.
# .env is gitignored — never commit it.

# --- connection ---
# Local Bitcoin Core/Knots defaults: http on 8332.
BITCOIN_RPC_HOST=127.0.0.1
BITCOIN_RPC_PORT=8332
BITCOIN_RPC_SCHEME=http

# Set false ONLY for a self-signed cert on a node you trust
# (e.g. Start9, Umbrel over LAN). Leave true otherwise.
BITCOIN_RPC_VERIFY_TLS=true

# --- credentials ---
# From bitcoin.conf (rpcuser/rpcpassword) or your node's admin UI.
BITCOIN_RPC_USER=your_rpc_username
BITCOIN_RPC_PASSWORD=your_rpc_password

# --- provenance: recorded in the `client` column of every CSV row ---
# Must match the node actually serving these requests.
BITCOIN_CLIENT=knots-29.4
BITCOIN_CHAIN=mainnet